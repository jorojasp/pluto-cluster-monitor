# ADALM-Pluto USB access for non-root users (based on ADI's plutosdr-fw rules).
# Installed by scripts/install_linux.sh into /etc/udev/rules.d/.
# uaccess grants the logged-in desktop user access; MODE 0666 also covers
# headless/SSH sessions such as the Raspberry Pi nodes.

# DFU (firmware update) mode
SUBSYSTEM=="usb", ATTRS{idVendor}=="0456", ATTRS{idProduct}=="b674", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2fa2", ATTRS{idProduct}=="5a32", MODE="0666", TAG+="uaccess"

# Normal SDR mode
SUBSYSTEM=="usb", ATTRS{idVendor}=="0456", ATTRS{idProduct}=="b673", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2fa2", ATTRS{idProduct}=="5a02", MODE="0666", TAG+="uaccess"

# Keep ModemManager from probing the Pluto's USB serial/network interfaces
SUBSYSTEM=="usb", ATTRS{idVendor}=="0456", ATTRS{idProduct}=="b673", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2fa2", ATTRS{idProduct}=="5a02", ENV{ID_MM_DEVICE_IGNORE}="1"
